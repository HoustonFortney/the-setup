{
    "model": "opus",
    "includeCoAuthoredBy": true,
    "editorMode": "vim",
    "tui": "fullscreen",
    "permissions": {
        "allow": [
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(ls:*)",
            "Bash(pwd:*)",
            "Bash(cat:*)",
            "Bash(file:*)",
            "Bash(stat:*)",
            "Bash(grep:*)",
            "Bash(rg:*)",
            "Bash(find:*)",
            "Bash(fdfind:*)",
            "Bash(tree:*)",
            "Bash(jq:*)",
            "Bash(wc:*)",
            "Bash(head:*)",
            "Bash(tail:*)",
            "Bash(ruff:*)"
        ],
        "deny": [],
        "ask": [
            "Bash(git commit:*)",
            "Bash(git push:*)",
            "Bash(kubectl:*)",
            "Bash(terraform:*)",
            "Bash(helm:*)"
        ]
    },
    "statusLine": {
        "type": "command",
        "command": "python3 ~/.claude/statusline.py",
        "padding": 0
    },
    "hooks": {
        "Notification": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/notify-tmux.sh"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/.claude/notify-tmux.sh"
                    }
                ]
            }
        ]
    }
}
