[global]
    follow = mouse
    notification_limit = 5

    progress_bar_frame_width = 0
    progress_bar_corner_radius = 4

    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    gap_size = 8
    frame_width = 2
    corner_radius = 8

    font = JetBrainsMono Nerd Font 10
    line_height = 2
    ellipsize = end
    show_indicators = false

    max_icon_size = 48

    dmenu = /usr/bin/rofi -dmenu -p action
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

# Dracula, matching the i3 window colors
[urgency_low]
    background = "#282A36"
    foreground = "#BFBFBF"
    frame_color = "#44475A"
    timeout = 5

[urgency_normal]
    background = "#282A36"
    foreground = "#F8F8F2"
    frame_color = "#6272A4"
    highlight = "#BD93F9"
    timeout = 5

[urgency_critical]
    background = "#282A36"
    foreground = "#F8F8F2"
    frame_color = "#FF5555"
