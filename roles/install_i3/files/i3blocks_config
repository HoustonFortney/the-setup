separator_block_width=24

[cpu]
label=
command=/usr/share/i3blocks/cpu_usage
interval=5

[memory]
label=󰍛
command=awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} END{printf "%d%%\n", (t-a)*100/t}' /proc/meminfo
interval=5

[date]
label=
command=date '+%m-%d-%Y'
interval=60

[time]
label=
command=date '+%H:%M'
interval=5
